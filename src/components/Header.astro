---
import DiscoveryButton from './DiscoveryButton.astro';
import PhoneLink from './PhoneLink.astro';

const path = Astro.url.pathname;
const nav = [
  { href: '/videos/', label: 'Videos' },
  { href: '/services/', label: 'Services' },
  { href: '/about/', label: 'About' },
  { href: '/contact/', label: 'Contact' },
];
---
<header class="hm-header" id="top">
  <div class="hm-container hm-header__inner">
    <a class="hm-logo" href="/" rel="home">
      <img class="hm-logo__img" src="/images/logo-white.webp" width="640" height="117" alt="Hughes Media digital agency" />
    </a>

    <button class="hm-nav-toggle" type="button" aria-controls="hm-nav" aria-expanded="false" aria-label="Open menu">
      <span class="hm-nav-toggle__bar" aria-hidden="true"></span>
    </button>

    <nav class="hm-nav" id="hm-nav" aria-label="Main">
      <ul class="hm-nav__list" role="list">
        {nav.map((item) => (
          <li>
            <a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>{item.label}</a>
          </li>
        ))}
      </ul>
      <div class="hm-nav__actions">
        <PhoneLink class="hm-header__phone" />
        <DiscoveryButton class="hm-header__cta" />
      </div>
    </nav>
  </div>
</header>
