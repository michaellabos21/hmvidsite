---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import VideoCard from '../../components/VideoCard.astro';
import CtaBand from '../../components/CtaBand.astro';
import { industries, videoTypes } from '../../data/site';
import { getVideos } from '../../lib/videos';

const videos = await getVideos();
// Only offer filters that have at least one video.
const groups = [
  { key: 'type', label: 'Type', terms: videoTypes.filter((t) => videos.some((v) => v.data.type === t.slug)) },
  { key: 'industry', label: 'Industry', terms: industries.filter((i) => videos.some((v) => v.data.industry === i.slug)) },
].filter((g) => g.terms.length > 0);
const total = videos.length;
---
<Base
  title="Videos | Hughes Media Video"
  description="Watch brand films, commercials, testimonials, and short-form video from Hughes Media. Browse by video type or industry."
>
  <PageHeader title="Our Videos" sub="Browse by type or industry. Each video shows what it was made to do and what we handled." />

  <!--
    Every video is rendered; filtering and "Show more" run in the browser.
    ?type=slug&industry=slug pre-filters (links from the main site and Services page).
  -->
  <section class="hm-section hm-work" data-work>
    <div class="hm-container">
      {groups.length > 0 && (
        <div class="hm-filters" role="region" aria-label="Filter videos">
          {groups.map((g) => (
            <div class="hm-filters__group" role="group" aria-labelledby={`hm-filter-${g.key}`} data-filter-group={g.key}>
              <span class="hm-filters__label" id={`hm-filter-${g.key}`}>{g.label}</span>
              <ul class="hm-chips" role="list">
                <li><a class="hm-chip" href="/videos/" data-value="" aria-current="true">All</a></li>
                {g.terms.map((t) => (
                  <li><a class="hm-chip" href={`/videos/?${g.key}=${t.slug}`} data-value={t.slug}>{t.name}</a></li>
                ))}
              </ul>
            </div>
          ))}
          <div class="hm-filters__meta">
            <p class="hm-filters__count" data-count aria-live="polite">{total === 1 ? 'Showing 1 video' : `Showing ${total} videos`}</p>
            <a class="hm-filters__clear" href="/videos/" data-clear hidden>Clear filters</a>
          </div>
        </div>
      )}

      <div class="hm-grid" data-grid>
        {videos.map((v) => <VideoCard video={v} headingLevel={2} />)}
      </div>

      <div class="hm-empty" data-empty hidden={total > 0}>
        {total > 0 ? (
          <>
            <h2 class="hm-empty__title">No videos match those filters yet.</h2>
            <p>Try a different type or industry, or clear the filters to see everything.</p>
            <a class="hm-btn hm-btn--secondary hm-empty__clear" href="/videos/">Clear filters</a>
          </>
        ) : (
          <>
            <h2 class="hm-empty__title">Videos are on the way.</h2>
            <p>We're adding our latest work. In the meantime, let's talk about your next video.</p>
          </>
        )}
      </div>

      <div class="hm-more">
        <button type="button" class="hm-btn hm-btn--secondary" data-more hidden>Show more videos</button>
        <p class="hm-more__end" data-end hidden></p>
      </div>
    </div>
  </section>

  <CtaBand />
</Base>
