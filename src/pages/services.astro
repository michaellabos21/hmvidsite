---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import CtaBand from '../components/CtaBand.astro';
import { videoTypeMainUrl, videoTypes } from '../data/site';

const steps = [
  { title: 'Plan', desc: 'Goals, audience, and where the video will run come first. Then concept, script, and shot list.' },
  { title: 'Shoot', desc: 'Our crew handles casting, locations, lighting, sound, and drone, on site or in the studio.' },
  { title: 'Edit', desc: 'Editing, color, motion graphics, music, and captions, cut for every platform you need.' },
  { title: 'Launch', desc: 'Videos go straight into your ads, website, and social, run by the same Hughes Media team.' },
];
---
<Base
  title="Video Production Services | Hughes Media Video"
  description="Brand films, commercials, testimonials, short-form, event, and animated video, planned, shot, and edited by one Atlanta team."
>
  <PageHeader title="Video Production" sub="One team from first idea to final cut, and into the campaigns that put it to work." />

  <section class="hm-section">
    <div class="hm-container">
      <ul class="hm-services" role="list">
        {videoTypes.map((t) => (
          <li class="hm-service">
            <h2 class="hm-service__title">{t.name}</h2>
            <p class="hm-service__desc">{t.desc}</p>
            <p class="hm-service__links">
              <a class="hm-link-arrow" href={`/videos/?type=${t.slug}`}>Watch examples →</a>
              <a class="hm-link-subtle" href={videoTypeMainUrl(t.slug)}>Service details on hughesmedia.us →</a>
            </p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="hm-section hm-section--gray" aria-labelledby="hm-process">
    <div class="hm-container">
      <h2 class="hm-section__title" id="hm-process">How We Work</h2>
      <ol class="hm-steps" role="list">
        {steps.map((s) => (
          <li class="hm-step">
            <h3 class="hm-step__title">{s.title}</h3>
            <p>{s.desc}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <CtaBand />
</Base>
