---
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import DiscoveryButton from '../components/DiscoveryButton.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Stats from '../components/Stats.astro';
import CtaBand from '../components/CtaBand.astro';
import { home, links } from '../data/site';
import { getFeatured, getProjects, projectName, projectUrl } from '../lib/projects';

const featured = await getFeatured(6);
const testimonials = (await getProjects()).filter((p) => p.data.testimonial).slice(0, 3);
---
<Base
  title="Hughes Media Portfolio | Digital Marketing Results"
  description="See SEO, PPC, web design, and video projects from Hughes Media, an Atlanta digital marketing agency since 2000."
>
  <section class="hm-hero hm-band hm-band--dark" aria-labelledby="hm-hero-title">
    <div class="hm-container hm-hero__inner">
      <p class="hm-eyebrow">Hughes Media Portfolio</p>
      <h1 class="hm-hero__title" id="hm-hero-title">{home.headline}</h1>
      <p class="hm-hero__sub">SEO, paid media, websites, and video built around one goal: more of the right leads for midsize businesses.</p>
      <div class="hm-actions">
        <Button href="/work/" size="lg">See Our Work</Button>
        <DiscoveryButton variant="ghost-light" size="lg" />
      </div>
    </div>
  </section>

  {featured.length > 0 && (
    <section class="hm-section" aria-labelledby="hm-featured-title">
      <div class="hm-container">
        <div class="hm-section__head">
          <div>
            <h2 class="hm-section__title" id="hm-featured-title">Featured Projects</h2>
            <p class="hm-section__intro">A few recent projects and the results they produced.</p>
          </div>
          <a class="hm-link-arrow" href="/work/">View all work →</a>
        </div>
        <div class="hm-grid">
          {featured.map((p) => <ProjectCard project={p} />)}
        </div>
      </div>
    </section>
  )}

  <section class="hm-results hm-band hm-band--red" aria-label="Results">
    <div class="hm-container">
      <Stats stats={home.stats} variant="strip" />
    </div>
  </section>

  {home.clientLogos.length > 0 && (
    <section class="hm-section hm-section--gray" aria-labelledby="hm-logos-title">
      <div class="hm-container">
        <h2 class="hm-section__title hm-section__title--center" id="hm-logos-title">Trusted by businesses across the Southeast and beyond</h2>
        <ul class="hm-logos" role="list">
          {home.clientLogos.map((l) => <li><img src={l.src} alt={l.alt} loading="lazy" /></li>)}
        </ul>
      </div>
    </section>
  )}

  {testimonials.length > 0 && (
    <section class="hm-section" aria-labelledby="hm-testimonials-title">
      <div class="hm-container">
        <div class="hm-section__head">
          <h2 class="hm-section__title" id="hm-testimonials-title">What Clients Say</h2>
          <a class="hm-link-arrow" href={links.reviews}>Read more reviews →</a>
        </div>
        <div class="hm-quotes">
          {testimonials.map((p) => (
            <figure class="hm-quote">
              <blockquote><p>{p.data.testimonial!.quote}</p></blockquote>
              <figcaption>
                {p.data.testimonial!.name && <span class="hm-quote__name">{p.data.testimonial!.name}</span>}
                <a class="hm-quote__project" href={projectUrl(p)}>{projectName(p)}</a>
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>
  )}

  <CtaBand />
</Base>
