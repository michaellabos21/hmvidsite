---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import CtaBand from '../../components/CtaBand.astro';
import { industries, services } from '../../data/site';
import { getProjects } from '../../lib/projects';

const projects = await getProjects();
// Only offer filters that have at least one project.
const groups = [
  { key: 'service', label: 'Service', terms: services.filter((s) => projects.some((p) => (p.data.services as string[]).includes(s.slug))) },
  { key: 'industry', label: 'Industry', terms: industries.filter((i) => projects.some((p) => p.data.industry === i.slug)) },
].filter((g) => g.terms.length > 0);
const total = projects.length;
---
<Base
  title="Our Work | Hughes Media Portfolio"
  description="Browse Hughes Media client projects by service and industry, with the results each one produced."
>
  <PageHeader
    title="Our Work"
    sub="Browse projects by service or industry. Each one shows the challenge, what we did, and what changed."
  />

  <!--
    Every project is rendered; filtering and "Show more" run in the browser.
    ?service=slug&industry=slug pre-filters (links from the main site and Services page).
  -->
  <section class="hm-section hm-work" data-work>
    <div class="hm-container">
      {groups.length > 0 && (
        <div class="hm-filters" role="region" aria-label="Filter projects">
          {groups.map((g) => (
            <div class="hm-filters__group" role="group" aria-labelledby={`hm-filter-${g.key}`} data-filter-group={g.key}>
              <span class="hm-filters__label" id={`hm-filter-${g.key}`}>{g.label}</span>
              <ul class="hm-chips" role="list">
                <li><a class="hm-chip" href="/work/" data-value="" aria-current="true">All</a></li>
                {g.terms.map((t) => (
                  <li><a class="hm-chip" href={`/work/?${g.key}=${t.slug}`} data-value={t.slug}>{t.name}</a></li>
                ))}
              </ul>
            </div>
          ))}
          <div class="hm-filters__meta">
            <p class="hm-filters__count" data-count aria-live="polite">{total === 1 ? 'Showing 1 project' : `Showing ${total} projects`}</p>
            <a class="hm-filters__clear" href="/work/" data-clear hidden>Clear filters</a>
          </div>
        </div>
      )}

      <div class="hm-grid" data-grid>
        {projects.map((p) => <ProjectCard project={p} headingLevel={2} />)}
      </div>

      <div class="hm-empty" data-empty hidden={total > 0}>
        {total > 0 ? (
          <>
            <h2 class="hm-empty__title">No projects match those filters yet.</h2>
            <p>Try a different service or industry, or clear the filters to see everything.</p>
            <a class="hm-btn hm-btn--secondary hm-empty__clear" href="/work/">Clear filters</a>
          </>
        ) : (
          <>
            <h2 class="hm-empty__title">Projects are on the way.</h2>
            <p>We're adding our latest client work. In the meantime, let's talk about yours.</p>
          </>
        )}
      </div>

      <div class="hm-more">
        <button type="button" class="hm-btn hm-btn--secondary" data-more hidden>Show more projects</button>
        <p class="hm-more__end" data-end hidden></p>
      </div>
    </div>
  </section>

  <CtaBand />
</Base>
