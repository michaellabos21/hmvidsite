---
import { Image, getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Button from '../../components/Button.astro';
import Stats from '../../components/Stats.astro';
import CtaBand from '../../components/CtaBand.astro';
import { business, links, serviceBySlug, serviceMainUrl } from '../../data/site';
import {
  clientIsPublic,
  getProjects,
  heroAlt,
  industryName,
  md,
  projectName,
  projectUrl,
  serviceNames,
  videoEmbedUrl,
  type Project,
} from '../../lib/projects';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: { project, prev: projects[i - 1] ?? null, next: projects[i + 1] ?? null },
  }));
}

interface Props {
  project: Project;
  prev: Project | null;
  next: Project | null;
}

const { project: p, prev, next } = Astro.props;
const d = p.data;
const name = projectName(p);
const isPublic = clientIsPublic(p);
const svcNames = serviceNames(p);
const industry = industryName(p);
const embed = d.videoUrl ? videoEmbedUrl(d.videoUrl) : null;
const liveUrl = isPublic ? d.liveUrl : undefined;

// SEO: "[Client]: [Outcome] | Hughes Media" and the spec's description template.
const title = `${name}: ${d.outcome} | Hughes Media`;
const outcomeLower = d.outcome.charAt(0).toLowerCase() + d.outcome.slice(1);
let description = `How Hughes Media helped ${name} get ${outcomeLower} with ${svcNames.join(', ')}. See the challenge, approach, and results.`;
if (description.length > 170) description = d.summary;

const ogImage = await getImage({ src: d.heroImage, width: 1200, height: 630, format: 'jpg', fit: 'cover' });
const gallery = await Promise.all(
  d.gallery.map(async (g) => ({ ...g, full: await getImage({ src: g.src, width: 1600, format: 'webp' }) })),
);

const creativeWork = {
  '@type': 'CreativeWork',
  name: `${name}: ${d.outcome}`,
  description: d.summary,
  url: new URL(projectUrl(p), Astro.site).href,
  datePublished: d.date.toISOString(),
  image: new URL(ogImage.src, Astro.site).href,
  creator: { '@id': `${links.mainSite}#organization`, '@type': 'Organization', name: business.name },
  keywords: svcNames.join(', '),
  genre: industry,
  ...(d.videoUrl ? { video: d.videoUrl } : {}),
};
---
<Base title={title} description={description} image={ogImage.src} type="article" canonical={d.canonicalUrl} schema={[creativeWork]}>
  <article class="hm-project">
    <header class="hm-project-hero hm-band hm-band--dark">
      <div class="hm-container hm-project-hero__inner">
        {d.draft && <p class="hm-draft-note">Draft: not included in the production build.</p>}
        <p class="hm-eyebrow">{industry} · {svcNames.join(' · ')}</p>
        <h1 class="hm-project-hero__title">{name}: {d.outcome}</h1>
        <p class="hm-project-hero__sub">{d.summary}</p>
        <dl class="hm-meta">
          <div><dt>Client</dt><dd>{name}</dd></div>
          <div><dt>Industry</dt><dd>{industry}</dd></div>
          <div><dt>Services</dt><dd>{svcNames.join(', ')}</dd></div>
          {d.period && <div><dt>Timeframe</dt><dd>{d.period}</dd></div>}
        </dl>
        {!isPublic && <p class="hm-anon-note">Client name withheld at the client's request.</p>}
      </div>
    </header>

    <figure class="hm-project-image hm-container">
      <Image
        src={d.heroImage}
        alt={heroAlt(p)}
        widths={[640, 1200, 2400]}
        sizes="(min-width: 1264px) 1200px, 100vw"
        format="webp"
        loading="eager"
        fetchpriority="high"
      />
    </figure>

    <div class="hm-container hm-project__body">
      <section class="hm-project__section" aria-labelledby="hm-challenge">
        <h2 id="hm-challenge">The Challenge</h2>
        <div class="hm-prose" set:html={md(d.challenge)} />
      </section>

      <section class="hm-project__section" aria-labelledby="hm-approach">
        <h2 id="hm-approach">Our Approach</h2>
        <div class="hm-prose" set:html={md(d.approach)} />
      </section>

      <section class="hm-project__section hm-project__results" aria-labelledby="hm-results">
        <h2 id="hm-results">The Results</h2>
        <Stats stats={d.stats} variant="callouts" />
        <div class="hm-prose" set:html={md(d.results)} />
        {d.statsFootnote && <p class="hm-footnote">{d.statsFootnote}</p>}
      </section>
    </div>

    {(d.videoUrl || gallery.length > 0) && (
      <section class="hm-section hm-section--gray" aria-labelledby="hm-see">
        <div class="hm-container">
          <h2 class="hm-section__title" id="hm-see">See the Work</h2>
          {d.videoUrl && (
            <>
              {embed ? (
                <div class="hm-video">
                  <iframe
                    src={embed}
                    title={`${name} project video`}
                    loading="lazy"
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                    allowfullscreen
                  ></iframe>
                </div>
              ) : (
                <Button href={d.videoUrl} variant="secondary" newTab>Watch the project video</Button>
              )}
              {links.videoSite && (
                <p class="hm-video__more"><a href={links.videoSite}>Watch more on the Hughes Media video site →</a></p>
              )}
            </>
          )}

          {gallery.length > 0 && (
            <>
              <ul class="hm-gallery" role="list" data-gallery>
                {gallery.map((g, i) => (
                  <li>
                    <a class="hm-gallery__item" href={g.full.src} data-index={i}>
                      <Image src={g.src} alt={g.alt} widths={[360, 720]} sizes="(min-width: 900px) 33vw, 100vw" format="webp" loading="lazy" />
                    </a>
                  </li>
                ))}
              </ul>
              <dialog class="hm-lightbox" data-lightbox aria-label="Image gallery">
                <button type="button" class="hm-lightbox__close" data-close aria-label="Close">×</button>
                <button type="button" class="hm-lightbox__nav hm-lightbox__nav--prev" data-prev aria-label="Previous image">‹</button>
                <img src="" alt="" data-lightbox-img />
                <button type="button" class="hm-lightbox__nav hm-lightbox__nav--next" data-next aria-label="Next image">›</button>
              </dialog>
            </>
          )}
        </div>
      </section>
    )}

    <div class="hm-container hm-project__body">
      {d.testimonial && (
        <section class="hm-project__section" aria-labelledby="hm-words">
          <h2 id="hm-words">In Their Words</h2>
          <figure class="hm-quote hm-quote--large">
            <blockquote><p>{d.testimonial.quote}</p></blockquote>
            {d.testimonial.name && <figcaption><span class="hm-quote__name">{d.testimonial.name}</span></figcaption>}
          </figure>
        </section>
      )}

      <section class="hm-project__section" aria-labelledby="hm-used">
        <h2 id="hm-used">Services Used</h2>
        <ul class="hm-service-links" role="list">
          {d.services.map((s) => (
            <li><a href={serviceMainUrl(s)}>Learn about our {serviceBySlug(s)?.name} services →</a></li>
          ))}
        </ul>
      </section>

      {liveUrl && (
        <p class="hm-project__live"><Button href={liveUrl} variant="secondary" newTab track="hm_outbound_click">Visit the live site</Button></p>
      )}
    </div>

    <nav class="hm-project-nav hm-container" aria-label="Projects">
      <div>{prev && <a href={projectUrl(prev)} rel="prev">← Previous project</a>}</div>
      <a class="hm-project-nav__back" href="/work/">Back to all work</a>
      <div class="hm-project-nav__next">{next && <a href={projectUrl(next)} rel="next">Next project →</a>}</div>
    </nav>
  </article>

  <CtaBand
    heading="Facing a similar challenge?"
    body="Let's talk through your goals and current marketing. No pitch, just a clear next step."
  />
</Base>
