---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { clientName, getVideos, videoUrl } from '../lib/videos';

const videos = await getVideos();
const pages = [
  { href: '/', label: 'Home' },
  { href: '/videos/', label: 'Videos' },
  { href: '/services/', label: 'Video Production Services' },
  { href: '/about/', label: 'About' },
  { href: '/contact/', label: 'Schedule a Discovery Call' },
  { href: '/privacy-policy/', label: 'Privacy Policy' },
];
---
<Base title="Sitemap | Hughes Media Video" description="All pages and videos on the Hughes Media video site.">
  <PageHeader title="Sitemap" />
  <section class="hm-section">
    <div class="hm-container hm-sitemap">
      <div>
        <h2>Pages</h2>
        <ul>{pages.map((p) => <li><a href={p.href}>{p.label}</a></li>)}</ul>
      </div>
      {videos.length > 0 && (
        <div>
          <h2>Videos</h2>
          <ul>{videos.map((v) => <li><a href={videoUrl(v)}>{v.data.title}: {clientName(v)}</a></li>)}</ul>
        </div>
      )}
    </div>
  </section>
</Base>
