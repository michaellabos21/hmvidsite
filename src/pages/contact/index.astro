---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import PhoneLink from '../../components/PhoneLink.astro';
import DiscoveryForm from '../../components/DiscoveryForm.astro';
import { addressLine, business } from '../../data/site';
---
<Base
  title="Schedule a Discovery Call | Hughes Media"
  description="Talk with Hughes Media about your next video: goals, where it will run, and budget. Get a clear next step, no pitch."
>
  <PageHeader
    title="Schedule a Discovery Call"
    eyebrow="Let's Talk"
    rec
    sub="Tell us about the video you need. We'll come to the call with ideas on approach, format, and budget."
  />
  <section class="hm-section">
    <div class="hm-container hm-contact">
      <div class="hm-contact__form" id="discovery-form">
        <p class="hm-kicker" aria-hidden="true">01 · Your Project</p>
        <DiscoveryForm />
      </div>
      <aside class="hm-contact__aside hm-slate">
        <div class="hm-slate__stripes" aria-hidden="true"></div>
        <p class="hm-slate__label" aria-hidden="true">02 · Next Steps</p>
        <h2 class="hm-contact__aside-title">What to expect</h2>
        <ol class="hm-expect" role="list">
          <li>We'll talk through what the video needs to do, who it's for, and where it will run.</li>
          <li>You'll get a straight answer on approach, timeline, and budget.</li>
          <li>If we're not the right fit, we'll tell you.</li>
        </ol>
        <div class="hm-contact__details">
          <h2 class="hm-contact__aside-title">Talk to us</h2>
          <p class="hm-contact__phone"><PhoneLink /></p>
          <address>{addressLine}</address>
          <p><a href={business.directionsUrl} target="_blank" rel="noopener">Get directions →<span class="screen-reader-text"> (opens in a new tab)</span></a></p>
        </div>
      </aside>
    </div>
  </section>
</Base>
