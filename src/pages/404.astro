---
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import { kangarooMark } from '../data/site';
---
<Base title="Page not found | Hughes Media Video" noindex>
  <section class="hm-404 hm-band hm-band--dark">
    <div class="hm-container hm-404__inner">
      {kangarooMark && <div class="hm-404__mark"><img src={kangarooMark} alt="" /></div>}
      <p class="hm-eyebrow">404</p>
      <h1 class="hm-404__title">This page hopped away.</h1>
      <p class="hm-404__body">The page you're looking for moved or never existed. Here are a few good places to go instead.</p>
      <div class="hm-actions hm-actions--center">
        <Button href="/videos/">Watch Our Work</Button>
        <Button href="/" variant="ghost-light">Go to Home</Button>
      </div>
    </div>
  </section>
</Base>
