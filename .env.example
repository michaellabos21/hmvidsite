# Production URL (no trailing slash). Used for canonical tags and the sitemap.
SITE_URL=https://www.your-portfolio-domain.com

# Where the discovery call form POSTs (CRM webhook, Formspree, HubSpot, Zapier...).
# Receives multipart form data; any 2xx response counts as success.
PUBLIC_LEAD_ENDPOINT=

# Google Tag Manager container, e.g. GTM-XXXXXXX
PUBLIC_GTM_ID=

# Set to 1 on staging: adds noindex and blocks all crawlers in robots.txt.
PUBLIC_NOINDEX=

# Set to 1 to include draft videos in a build (always shown in `npm run dev`).
SHOW_DRAFTS=
